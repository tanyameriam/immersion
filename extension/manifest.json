{
  "manifest_version": 3,
  "name": "Layrrrd — Save to your knowledge layer",
  "version": "1.0.0",
  "description": "Save any page to Layrrrd in one click. AI reads and summarizes it for you.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Layrrrd"
  },
  "permissions": ["identity", "activeTab", "storage"],
  "host_permissions": [
    "https://app.layrrrd.com/*",
    "http://localhost:3000/*"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_YOUR_CHROME_EXTENSION_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  }
}
