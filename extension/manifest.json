{
  "manifest_version": 3,
  "key": "",
  "name": "Layrrrd: Save to your knowledge layer",
  "version": "1.1.0",
  "description": "Save any page to Layrrrd in one click. AI reads and summarizes it for you.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Layrrrd",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["identity", "activeTab", "storage"],
  "host_permissions": [
    "https://layrrrd.com/*",
    "https://layrrrd.vercel.app/*",
    "https://immersion-one.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://layrrrd.com/*",
        "https://layrrrd.vercel.app/*",
        "https://immersion-one.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "oauth2": {
    "client_id": "820564255223-n9klbkap9leliu5jt3e7qprb7n33rpci.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  }
}
