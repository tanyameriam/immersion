# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must never be committed.
# In production, set these same variables in the Vercel dashboard
# (Project → Settings → Environment Variables).

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://layrrrd.com

# Google Apps Script webhook that the waitlist form forwards signups to.
GOOGLE_SCRIPT_URL=

# ─────────────────────────────────────────────────────────────
# Firebase Web config (PUBLIC — safe to expose; used by the browser SDK)
# Firebase Console → Project settings → General → Your apps → Web app
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# Firebase Admin (SERVER SECRET — service account; never expose)
# Firebase Console → Project settings → Service accounts → Generate new private key
# Keep the literal \n characters in the private key; the code converts them.
# ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# AI — Anthropic Claude (pay-as-you-go; used server-side only)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Weekly digest — Telegram (free) + Resend email (Phase 6)
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Shared secret for the Telegram webhook (production only). Pick any long
# random string and pass the same value as secret_token to setWebhook:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d "url=https://app.layrrrd.com/api/telegram/webhook" \
#     -d "secret_token=$TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=digest@layrrrd.com

# ─────────────────────────────────────────────────────────────
# Background jobs — shared secret guarding cron/process endpoints
# Generate any long random string.
# ─────────────────────────────────────────────────────────────
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Recommendation sources (OPTIONAL — the feed degrades gracefully:
# any source with missing keys is skipped; Medium RSS needs none)
# ─────────────────────────────────────────────────────────────
# Google Cloud Console → enable "YouTube Data API v3" → create API key.
# Unset = no video recommendations.
YOUTUBE_API_KEY=
# developer.spotify.com → create an app → Client ID + Client secret.
# Unset pair = no podcast recommendations.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Google Programmable Search Engine (programmablesearchengine.google.com):
# create an engine that searches the entire web → cx id goes in GOOGLE_CSE_ID;
# Google Cloud Console → enable "Custom Search API" → API key.
# Unset pair = no web-wide article search picks.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ─────────────────────────────────────────────────────────────
# PostHog analytics (PUBLIC — safe to expose; used by the browser)
# posthog.com → Project settings → Project API key. Leave empty to
# disable analytics entirely (local dev, previews).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
