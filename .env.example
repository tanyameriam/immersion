# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must never be committed.
# In production, set these same variables in the Vercel dashboard
# (Project → Settings → Environment Variables).

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://layrrrd.com

# ─────────────────────────────────────────────────────────────
# Firebase Web config (PUBLIC — safe to expose; used by the browser SDK)
# Firebase Console → Project settings → General → Your apps → Web app
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local dev against the Firebase Emulator Suite instead of any real project
# (run `npm run emulators` in a second terminal). Set all three to opt in;
# leave them unset to develop against the layrrrd-test project instead.
# See docs/environments.md for the full dev/test/prod flow.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=1
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ─────────────────────────────────────────────────────────────
# Firebase Admin (SERVER SECRET — service account; never expose)
# Firebase Console → Project settings → Service accounts → Generate new private key
# Keep the literal \n characters in the private key; the code converts them.
# ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# AI — Anthropic Claude (pay-as-you-go; used server-side only)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Weekly digest — Telegram (free) + Resend email (Phase 6)
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Shared secret for the Telegram webhook (production only). Pick any long
# random string and pass the same value as secret_token to setWebhook:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d "url=https://app.layrrrd.com/api/telegram/webhook" \
#     -d "secret_token=$TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=digest@layrrrd.com
# Receives signup, referral, payment, and feedback notifications.
ADMIN_NOTIFICATION_EMAIL=layrrrd@gmail.com

# ─────────────────────────────────────────────────────────────
# Rudolf on WhatsApp — Meta WhatsApp Cloud API (replies to
# user-initiated chats are free inside the 24-hour window)
# Meta for Developers → your app → WhatsApp → API Setup.
# Webhook (WhatsApp → Configuration): callback URL
# https://app.layrrrd.com/api/whatsapp/webhook, verify token below,
# subscribe to the "messages" field. Webhook delivery needs a public
# URL, so linking/chat can't complete against plain localhost.
# ─────────────────────────────────────────────────────────────
# Permanent access token (System User token, not the 24h test token).
WHATSAPP_ACCESS_TOKEN=
# The "Phone number ID" of Rudolf's number (NOT the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# The number users message, digits only with country code, e.g. 31612345678.
# Used to build wa.me connect links.
WHATSAPP_BUSINESS_NUMBER=
# Any long random string; enter the same value as the webhook verify token.
WHATSAPP_VERIFY_TOKEN=
# Meta app secret (App settings → Basic) — verifies webhook signatures.
WHATSAPP_APP_SECRET=

# ─────────────────────────────────────────────────────────────
# Background jobs — shared secret guarding cron/process endpoints
# Generate any long random string.
# ─────────────────────────────────────────────────────────────
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Recommendation sources (OPTIONAL — the feed degrades gracefully:
# any source with missing keys is skipped; Medium RSS needs none)
# ─────────────────────────────────────────────────────────────
# Google Cloud Console → enable "YouTube Data API v3" → create API key.
# Unset = no video recommendations.
YOUTUBE_API_KEY=
# developer.spotify.com → create an app → Client ID + Client secret.
# Unset pair = no podcast recommendations.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Google Programmable Search Engine (programmablesearchengine.google.com):
# create an engine that searches the entire web → cx id goes in GOOGLE_CSE_ID;
# Google Cloud Console → enable "Custom Search API" → API key.
# Unset pair = no web-wide article search picks.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Gemini API key (aistudio.google.com/apikey) — lets Rudolf actually watch
# YouTube videos for content-based summaries when captions are unavailable.
# Unset = video summaries fall back to captions/description.
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# PostHog analytics (PUBLIC — safe to expose; used by the browser)
# posthog.com → Project settings → Project API key. Leave empty to
# disable analytics entirely (local dev, previews).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─────────────────────────────────────────────────────────────
# Razorpay billing — dashboard.razorpay.com → Account & Settings → API Keys.
# Use test keys (rzp_test_...) locally; live keys (rzp_live_...) only in
# Vercel Production. Webhook: Dashboard → Webhooks → Add,
# URL https://layrrrd.com/api/payments/webhook, event "payment.captured",
# secret = any long random string (the same value as below). Register the
# webhook separately in test mode and live mode.
# ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Same value as RAZORPAY_KEY_ID; PUBLIC — the browser checkout widget needs it.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
