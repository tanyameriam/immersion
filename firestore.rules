rules_version = '2';

// Layrrrd Firestore security rules.
// Principle: users read/write ONLY their own data. AI-derived fields and
// backend-only collections are never writable from the client — those writes
// go through the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function owns(resourceData) {
      return signedIn() && request.auth.uid == resourceData.userId;
    }

    // A user's own profile. Billing fields (plan, payment record) are
    // server-managed: the payment routes write them via the Admin SDK, and
    // clients can never set or change them - otherwise any signed-in user
    // could upgrade themselves for free.
    match /users/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('plan', 'free') == 'free'
        && !request.resource.data.keys().hasAny(
             ['paidAt', 'razorpayPaymentId', 'razorpayOrderId',
              'foundingMember', 'foundingSpot', 'biscuits', 'rudolf',
              'referralCode', 'referralCodeCreatedAt', 'referredByUid',
              'referredByCode', 'referredAt', 'signupAdminNotifiedAt',
              'referralAdminNotifiedAt', 'referrerSignupThankYouSentAt',
              'paidAdminNotifiedAt']);
      allow update: if signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plan', 'paidAt', 'razorpayPaymentId',
                     'razorpayOrderId', 'foundingMember', 'foundingSpot',
                     'biscuits', 'rudolf', 'referralCode',
                     'referralCodeCreatedAt', 'referredByUid',
                     'referredByCode', 'referredAt',
                     'signupAdminNotifiedAt', 'referralAdminNotifiedAt',
                     'referrerSignupThankYouSentAt',
                     'paidAdminNotifiedAt']);
    }

    // Per-user preferences.
    match /preferences/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Knowledge items. Clients may create/read/delete their own and toggle
    // user-facing flags, but may NOT write AI/status/ownership fields —
    // only the Admin SDK does.
    match /knowledgeItems/{itemId} {
      allow read, delete: if owns(resource.data);
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userId;
      allow update: if owns(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ai', 'status', 'userId', 'processingStartedAt',
                     'retryCount', 'error', 'createdAt',
                     'keywords', 'topics']);
    }

    // Backend-generated; clients may read their own but never write.
    match /recommendations/{id} {
      allow read: if owns(resource.data);
      allow write: if false;
    }
    match /weeklyDigests/{id} {
      allow read: if owns(resource.data);
      allow write: if false;
    }
    match /notifications/{id} {
      allow read: if owns(resource.data);
      allow write: if false;
    }

    match /referrals/{id} {
      allow read, write: if false;
    }

    match /referralCodes/{id} {
      allow read, write: if false;
    }

    // Billing: founding-spot counter, payment ledger, and pending orders are
    // written only by the payment routes via the Admin SDK.
    match /billing/{id} {
      allow read, write: if false;
    }
    match /payments/{id} {
      allow read, write: if false;
    }
    match /paymentOrders/{id} {
      allow read, write: if false;
    }

    // Backend-only, no client access at all.
    match /analytics/{id} {
      allow read, write: if false;
    }
    // Rudolf's support receipts. They hold user message content, so no client
    // ever reads them - support looks them up server-side by reference code.
    // Retention is enforced by a Firestore TTL policy on `expiresAt`, and they
    // are deleted with the account (app/api/account/route.ts).
    match /botEvents/{id} {
      allow read, write: if false;
    }
    // Rudolf's per-chat memory, keyed by chat id rather than uid.
    match /telegramChats/{id} {
      allow read, write: if false;
    }
    match /feedCache/{id} {
      allow read, write: if false;
    }
    // Dead data from the removed proactive-nudge feature. Nothing writes here
    // any more; the remaining docs are per-user and are cleared on deletion.
    match /botNudges/{id} {
      allow read, write: if false;
    }
    match /systemJobs/{id} {
      allow read, write: if false;
    }
  }
}
