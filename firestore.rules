rules_version = '2';

// Layrrrd Firestore security rules.
// Principle: users read/write ONLY their own data. AI-derived fields and
// backend-only collections are never writable from the client — those writes
// go through the Admin SDK, which bypasses these rules.
//
// Firestore denies anything not matched below, so a collection with no block
// here is already locked. Only list a collection when it exists and the rule
// says something the default doesn't — a block for a collection that holds no
// data reads as though more of the system is built than actually is.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // Password signups must confirm their address before they can put content
    // in. Google accounts arrive with this claim already true. Existing
    // accounts were backfilled to true (scripts/backfill-email-verified.mjs),
    // so nobody who signed up before the check got locked out.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function owns(resourceData) {
      return signedIn() && request.auth.uid == resourceData.userId;
    }

    // A user's own profile. Billing fields (plan, payment record) are
    // server-managed: the payment routes write them via the Admin SDK, and
    // clients can never set or change them - otherwise any signed-in user
    // could upgrade themselves for free.
    //
    // Chat channel ids (telegramChatId, whatsappWaId) are set only by the
    // linking webhooks, which prove the user controls that chat. Clients may
    // clear them (Disconnect) but never set one - otherwise a user could
    // point their account at someone else's number, read that person's
    // messages to Rudolf, and aim (paid) WhatsApp digest prompts at them.
    function channelIdsCleared(data) {
      return data.get('telegramChatId', '') == ''
        && data.get('whatsappWaId', '') == '';
    }
    // On update, judge each id on its own: disconnecting one channel must
    // still work while the other stays linked.
    function onlyClearsChannelId(key) {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([key])
        || request.resource.data.get(key, '') == '';
    }
    match /users/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('plan', 'free') == 'free'
        && channelIdsCleared(request.resource.data)
        && !request.resource.data.keys().hasAny(
             ['paidAt', 'razorpayPaymentId', 'razorpayOrderId',
              'foundingMember', 'foundingSpot', 'biscuits', 'rudolf',
              'referralCode', 'referralCodeCreatedAt', 'referredByUid',
              'referredByCode', 'referredAt', 'signupAdminNotifiedAt',
              'referralAdminNotifiedAt', 'referrerSignupThankYouSentAt',
              'paidAdminNotifiedAt', 'whatsappLastInboundAt']);
      allow update: if signedIn() && request.auth.uid == userId
        && onlyClearsChannelId('telegramChatId')
        && onlyClearsChannelId('whatsappWaId')
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plan', 'paidAt', 'razorpayPaymentId',
                     'razorpayOrderId', 'foundingMember', 'foundingSpot',
                     'biscuits', 'rudolf', 'referralCode',
                     'referralCodeCreatedAt', 'referredByUid',
                     'referredByCode', 'referredAt',
                     'signupAdminNotifiedAt', 'referralAdminNotifiedAt',
                     'referrerSignupThankYouSentAt',
                     'paidAdminNotifiedAt', 'whatsappLastInboundAt']);
    }

    // Knowledge items. Clients may create/read/delete their own and toggle
    // user-facing flags, but may NOT write AI/status/ownership fields —
    // only the Admin SDK does.
    match /knowledgeItems/{itemId} {
      allow read, delete: if owns(resource.data);
      allow create: if verified()
        && request.auth.uid == request.resource.data.userId;
      allow update: if owns(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ai', 'status', 'userId', 'processingStartedAt',
                     'retryCount', 'error', 'createdAt',
                     'keywords', 'topics']);
    }

    // Backend-generated; clients may read their own but never write.
    match /weeklyDigests/{id} {
      allow read: if owns(resource.data);
      allow write: if false;
    }

    match /referrals/{id} {
      allow read, write: if false;
    }

    match /referralCodes/{id} {
      allow read, write: if false;
    }

    // Billing: founding-spot counter, payment ledger, and pending orders are
    // written only by the payment routes via the Admin SDK.
    match /billing/{id} {
      allow read, write: if false;
    }
    match /payments/{id} {
      allow read, write: if false;
    }
    match /paymentOrders/{id} {
      allow read, write: if false;
    }

    // Pending email-verification codes (hashed, with attempt counters). No
    // client ever touches these - only the Admin SDK in
    // lib/auth/email-verification.ts.
    match /emailVerifications/{id} {
      allow read, write: if false;
    }

    // Backend-only, no client access at all.
    // Rudolf's support receipts. They hold user message content, so no client
    // ever reads them - support looks them up server-side by reference code.
    // Retention is enforced by a Firestore TTL policy on `expiresAt`, and they
    // are deleted with the account (app/api/account/route.ts).
    match /botEvents/{id} {
      allow read, write: if false;
    }
    // Rudolf's per-chat memory, keyed by chat id rather than uid.
    match /telegramChats/{id} {
      allow read, write: if false;
    }
    match /feedCache/{id} {
      allow read, write: if false;
    }
    // Dead data from the removed proactive-nudge feature. Nothing writes here
    // any more; the remaining docs are per-user and are cleared on deletion.
    match /botNudges/{id} {
      allow read, write: if false;
    }
  }
}
